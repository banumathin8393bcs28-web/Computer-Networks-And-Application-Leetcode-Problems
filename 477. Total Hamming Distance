int totalHammingDistance(int* nums, int numsSize) {
    int total_dist = 0;
    
    for (int i = 0; i < 32; i++) {
        int ones = 0;
        
        for (int j = 0; j < numsSize; j++) {
            ones += (nums[j] >> i) & 1;
        }
        
        int zeros = numsSize - ones;
        total_dist += ones * zeros;
    }
    
    return total_dist;
}
