static int mat[100000][2];
int findMaximumXOR(int* a, int n) {
    if (n < 2) return 0;
    int id = 1;
    mat[0][0] = 0;
    mat[0][1] = 0;
    int m = 0;
    for (int i = 0; i < n; i++) {
        int v = a[i];
        int ins = 0, src = 0, cur = 0;
        for (int j = 30; j >= 0; j--) {
            int b = (v >> j) & 1;
            if (!mat[ins][b]) {
                mat[id][0] = 0;
                mat[id][1] = 0;
                mat[ins][b] = id++;
            }
            ins = mat[ins][b];
            if (i > 0) {
                int tb = 1 - b;
                if (mat[src][tb]) {
                    cur |= (1 << j);
                    src = mat[src][tb];
                } else {
                    src = mat[src][b];
                }
            }
        }
        if (i > 0 && cur > m) {
            m = cur;
        }
    }
    return m;
}
